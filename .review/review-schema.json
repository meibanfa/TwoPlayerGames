{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings", "verification_notes"],
  "properties": {
    "verdict": { "enum": ["PASS", "BLOCK"] },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "confidence", "title", "file", "line_start", "line_end", "category", "problem", "evidence", "failure_scenario", "fix_instruction", "suggested_test"],
        "properties": {
          "id": { "type": "string", "pattern": "^R[0-9]{3,}$" },
          "severity": { "enum": ["P0", "P1", "P2", "P3"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 },
          "category": { "type": "string", "minLength": 1 },
          "problem": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "failure_scenario": { "type": "string", "minLength": 1 },
          "fix_instruction": { "type": "string", "minLength": 1 },
          "suggested_test": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verification_notes": { "type": "array", "items": { "type": "string" } }
  }
}
